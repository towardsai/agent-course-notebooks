{
  "mcpServers": {
    "nova-research-agent": {
      "transport": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        "/usr/local/lib/python3.12/dist-packages/research_agent_part_2/mcp_server",
        "run",
        "-m",
        "src.server",
        "--transport",
        "stdio"
      ]
    },
    "brown-writing-workflow": {
      "transport": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        "/usr/local/lib/python3.12/dist-packages/brown",
        "run",
        "python",
        "-m",
        "mcp.server"
      ]
    }
  }
}